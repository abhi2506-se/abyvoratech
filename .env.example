# =============================================================================
# ENVIRONMENT VARIABLES — copy to .env.local (dev) or set in Vercel dashboard
# Never commit the real .env file.
# =============================================================================

# --- Database (Neon / Supabase Postgres connection string) -----------------
# Get it from: Neon dashboard > Connection Details, or Supabase > Project Settings > Database
# Use the *pooled* connection string for the app, and the direct one for migrations.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js -----------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"   # set to your production URL on Vercel

# --- Google OAuth (optional client login) ------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Razorpay ------------------------------------------------------------------
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Get from: Razorpay Dashboard > Account & Settings > Webhooks > Add new webhook
# Webhook URL to register there: https://YOUR_DOMAIN/api/webhooks/razorpay
# Events to enable: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=""

# --- Email (Resend) ------------------------------------------------------------
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Your Agency <notifications@yourdomain.com>"

# Proposal/Sales sender identities — the domain(s) used here MUST be verified
# in Resend (Domains > Add Domain > add the DNS records it gives you) before
# sending will work. Server picks the From address based on Email Type; the
# compose UI can never override it.
EMAIL_FROM_PROPOSAL="proposal.opervia@theabhisheksingh.in"
EMAIL_FROM_PROPOSAL_NAME="Opervia Proposals"
EMAIL_FROM_SALES="sales.opervia@theabhisheksingh.in"
EMAIL_FROM_SALES_NAME="Opervia Sales"
EMAIL_FROM_GENERAL="notifications@theabhisheksingh.in"
EMAIL_FROM_GENERAL_NAME="Opervia"

# Resend webhook signing secret — get it after creating the webhook below.
# Register this URL in Resend Dashboard > Webhooks > Add Endpoint:
#   https://YOUR_DOMAIN/api/webhooks/resend
# Events to enable: email.sent, email.delivered, email.bounced, email.opened,
# email.complained, email.delivery_delayed, email.failed
EMAIL_WEBHOOK_SECRET=""

# Inbound email webhook (for reply capture) — generic receiver, see
# src/app/api/webhooks/resend-inbound/route.ts for exact payload shape and
# which relay products can point at it (Resend inbound / Cloudflare Email
# Worker / Mailgun routes). Turn on in Admin > Email Settings once wired up.
# https://YOUR_DOMAIN/api/webhooks/resend-inbound
INBOUND_EMAIL_SECRET=""

# --- AI email generation (OpenAI-compatible: OpenAI, Groq, etc.) ---------------
# AI_BASE_URL examples:
#   OpenAI: https://api.openai.com/v1
#   Groq:   https://api.groq.com/openai/v1
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# --- Local file storage (dev / single-instance only — see src/lib/storage.ts) ---
# For serverless (Vercel) deployments, switch storage.ts to Supabase Storage/S3
# using the vars below instead; local disk does not persist across invocations.
LOCAL_STORAGE_ROOT=""

# --- Object Storage (Supabase Storage or S3) -----------------------------------
STORAGE_PROVIDER="supabase" # or "s3"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="agency-documents"
# If using S3 instead:
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_S3_BUCKET=""

# --- Translation (Google Cloud Translation API) --------------------------------
# Get from: https://console.cloud.google.com/apis/credentials (enable Cloud Translation API)
TRANSLATION_API_KEY=""

# --- App -----------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Portfolio integration (theabhisheksingh.in <-> Opervia) -------------------
# The portfolio site's backend calls POST /api/portfolio/handoff with this key
# in the x-portfolio-api-key header (server-to-server only, never from the
# visitor's browser) to get a short-lived signed redirect URL.
PORTFOLIO_API_KEY=""
# Must be set to the SAME value here and wherever the portfolio backend signs
# from, if it verifies independently. Used to HMAC-sign handoff tokens.
PORTFOLIO_HANDOFF_SECRET=""

# --- IT Support ------------------------------------------------------------------
# No separate env vars needed — IT_SUPPORT is a normal login role. Create the
# first IT Support account from Admin > IT Support Personnel after seeding.
# The panel lives at /IT/secretme and is enforced server-side by role in
# middleware.ts — the obscure path is not itself a security control.
